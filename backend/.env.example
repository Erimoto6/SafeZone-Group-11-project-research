# Copy this file to ".env" (same folder) and fill it in. NEVER upload ".env" to GitHub.

# --- the API ---
PORT=3000

# --- MySQL (the user and password from database/01-create-database.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=safezone_app
DB_PASSWORD=
DB_NAME=safezone

# --- login security ---
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Needed to create an admin account from the app's "Create an admin account" page.
ADMIN_ACCESS_CODE=SAFEZONE-ADMIN

# Highest floor number allowed when adding rooms (4 floors = 4).
MAX_FLOOR=4

# Which apps may call the API (comma separated). These cover Live Server and the Android app.
CORS_ORIGINS=http://localhost,https://localhost,http://127.0.0.1:5500,http://localhost:5500

# --- email for forgot password (leave SMTP_HOST empty while testing) ---
# Empty = the 6-digit code is printed in this terminal instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafeZone <your.project.mail@example.com>

# --- for the future hardware/alert service: lets it post alerts. Leave empty to switch that off. ---
DEVICE_API_KEY=
